#!/usr/bin/env python3
"""Fetch Claude plan usage and write it where the Plasma widget can read it.

Reads the OAuth access token Claude Code already keeps in
~/.claude/.credentials.json and makes one read-only request to the usage
endpoint. It never refreshes the token: Claude Code rotates refresh tokens, and a
second client refreshing could log it out. If the token has expired the script
keeps the last good numbers and flags them stale until Claude Code refreshes it.

Output: ~/.cache/claude-usage/usage.json
"""

import json
import os
import sys
import time
import urllib.request

CREDENTIALS = os.path.expanduser("~/.claude/.credentials.json")
OUTPUT = os.path.expanduser("~/.cache/claude-usage/usage.json")
URL = "https://api.anthropic.com/api/oauth/usage"
FABLE_NAME = "fable"


def parse_usage(payload):
    """Pull the weekly and Fable bars out of an API response.

    Returns {"weekly": {...} | None, "fable": {...} | None}, each entry holding
    "percent" and "resets_at".
    """
    weekly = None
    fable = None
    for limit in payload.get("limits") or []:
        entry = {"percent": limit.get("percent"), "resets_at": limit.get("resets_at")}
        if limit.get("kind") == "weekly_all":
            weekly = entry
        elif limit.get("kind") == "weekly_scoped":
            model = ((limit.get("scope") or {}).get("model") or {}).get("display_name") or ""
            if model.lower() == FABLE_NAME:
                fable = entry
    if weekly is None and payload.get("seven_day"):
        seven_day = payload["seven_day"]
        weekly = {"percent": seven_day.get("utilization"), "resets_at": seven_day.get("resets_at")}
    return {"weekly": weekly, "fable": fable}


def load_previous():
    try:
        with open(OUTPUT) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def write_output(document):
    os.makedirs(os.path.dirname(OUTPUT), exist_ok=True)
    temporary = OUTPUT + ".tmp"
    with open(temporary, "w") as handle:
        json.dump(document, handle)
    os.replace(temporary, OUTPUT)


def fetch(token):
    request = urllib.request.Request(
        URL,
        headers={
            "Authorization": "Bearer " + token,
            "anthropic-beta": "oauth-2025-04-20",
            "User-Agent": "claude-usage-fetch",
        },
    )
    with urllib.request.urlopen(request, timeout=15) as response:
        return json.load(response)


def main():
    previous = load_previous()
    document = {
        "ok": False,
        "error": None,
        "fetched_at": previous.get("fetched_at"),
        "weekly": previous.get("weekly"),
        "fable": previous.get("fable"),
    }
    try:
        with open(CREDENTIALS) as handle:
            oauth = json.load(handle)["claudeAiOauth"]
        if oauth.get("expiresAt", 0) / 1000 <= time.time():
            raise RuntimeError("access token expired; open Claude Code to refresh it")
        parsed = parse_usage(fetch(oauth["accessToken"]))
        if parsed["weekly"] is None:
            raise RuntimeError("response had no weekly limit")
        document.update(ok=True, fetched_at=int(time.time()), **parsed)
    except Exception as error:  # keep the last good numbers, report why they are stale
        document["error"] = str(error)
    write_output(document)
    return 0 if document["ok"] else 1


if __name__ == "__main__":
    sys.exit(main())
